# This config sets the default target and profile of dbt
export DBT_PROFILE_TARGET="indimesh_databricks";
export DBT_DEFAULT_TARGET="dev";
# export DBT_DEFER="true";
# export DBT_STATE="target-defer";
# export DBT_FAVOR_STATE="true";

# Set your schema to be dev_FIRSTNAME_LASTNAME
export DEV_SCHEMA_NAME="<YOUR DEV SCHEMA HERE>";

# ----------------------------- #
# Databricks adapter variables  #
# ----------------------------- #
# Config the databricks and access token credentials here
export DEV_DATABRICKS_CATALOG="bv_dev_db";
export DEV_DATABRICKS_HOST="<DEV HOST HERE>";
export DEV_DATABRICKS_HTTP_PATH="<DEV CLUSTER HTTP PATH HERE WITHOUT THE FIST "/">";
export DEV_DATABRICKS_TOKEN="<YOUR DATABRICKS PERSONAL TOKEN HERE>";
export DBT_DATABRICKS_ALLPURPOSE_CLUSTER_ID="<YOUR DATABRICKS ALL PURPOSE CLUSTER IF NECESSARY>";

