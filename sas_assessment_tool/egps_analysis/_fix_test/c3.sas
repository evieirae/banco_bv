LIBNAME GG '/p';
PROC SQL; CONNECT TO BIGQUERY AS P (project='x');
CREATE TABLE O1 AS SELECT * FROM CONNECTION TO P (SELECT k FROM bv-x.d.t1 WHERE a=1 GROUP BY k) AS A
LEFT JOIN GG.CAL1 AS D ON A.k=D.k;
CREATE TABLE O2 AS SELECT * FROM CONNECTION TO P (SELECT k FROM bv-x.d.t2 WHERE a=1 GROUP BY k) AS A
LEFT JOIN GG.CAL2 AS D ON A.k=D.k; QUIT;
