{
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(sqlfluff *)",
      "Bash(pip *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(python tools/github_tools.py *)",
      "Bash(rm -rf draft_models)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/post_file_edit.py"
          }
        ]
      }
    ]
  }
}
