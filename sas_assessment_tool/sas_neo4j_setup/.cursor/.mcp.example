{
  "mcpServers": {
    "neo4j": {
      "command": "npx",
      "args": ["-y", "@alanse/mcp-neo4j-server"],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "defaultpassword",
        "NEO4J_DATABASE": "neo4j"
      }
    }
  }
}